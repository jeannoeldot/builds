pkgname=opentimelineio-git-jnd
pkgver=0.19.0.20261014
pkgrel=1
_pkgname_git=opentimelineio-git
pkgdesc="Open Source API and interchange format for editorial timeline information"
url="https://github.com/AcademySoftwareFoundation/OpenTimelineIO"
arch=('x86_64')
license=('Apache-2.0')
depends=('glibc' 'libgcc' 'libstdc++' 'zlib'
         'python'
         'python-aaf2'
)
makedepends=('cmake' 'git' 'minizip-ng'
             'imath' 'pybind11' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel'
)
conflicts=('opentimelineio')
provides=('opentimelineio')
#options=(staticlibs)
options=('!debug')
source=("${_pkgname_git}-${pkgver}.tar.gz"
        "opentimelineio-rapidjson::git+https://github.com/Tencent/rapidjson"
        "opentimelineio.diff"
        "opentimelineio_shared.diff"
)
sha256sums=('dda65bb2a070ef63ee8cd8f9bb622c9f7dabe4a4b34f58060f75cbcf8b506402'
            'SKIP'
            'acc4b971d0ef8694d4bf26c75c34c7892b89de3e218d03dbf28d675162b66cb3'
            'b49351153bd03960e81985608ca67c7d0b48036b8a8e2774449b411db06e5039'
)

_gitname="opentimelineio"

