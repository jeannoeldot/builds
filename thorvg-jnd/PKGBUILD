# Maintainer: Moi <name AT fai DOT fr>

pkgname=thorvg-jnd
pkgver=1.1.0.20260722
pkgrel=1
_ver_release="1.1.0"
_name_release="thorvg-${_ver_release}"
pkgdesc="Portable library designed for rendering vector-based scenes and animations, including SVG and Lottie formats"
url="https://github.com/thorvg/thorvg"
arch=('x86_64')
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++'
)
makedepends=('meson' 'ninja'
)
conflicts=('thorvg')
provides=('thorvg')
#options=(staticlibs)
options=('!debug')
source=("thorvg-${_ver_release}.tar.gz"
)
sha256sums=('73943bcf918c9ffdf11acc53052ba5cb60a7047b1cfb2067afeb62e0c4d9417d'
)

prepare() {
  cd "${_name_release}"
  meson setup builddir --prefix=/usr \
    -Dloaders=svg \
    -Dextra= \
    --reconfigure
}

build() {
  cd "${_name_release}"

  ninja -C builddir
}

package() {
  cd "${_name_release}"
  
  DESTDIR="${pkgdir}" ninja -C builddir install

  # license
  install -Dm644 LICENSE "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
