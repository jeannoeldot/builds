# Maintainer: Moi <name AT fai DOT fr>

pkgname=joltphysics-jnd
pkgver=5.6.0.20260711
pkgrel=1
_ver_release="5.6.0"
_name_release="JoltPhysics-${_ver_release}"
pkgdesc="A multi core friendly rigid body physics and collision detection library"
url="https://github.com/jrouwe/JoltPhysics"
arch=('x86_64')
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++'
)
makedepends=('cmake'
             'vulkan-icd-loader'
)
conflicts=('joltphysics')
provides=('joltphysics')
#options=(staticlibs)
options=('!debug')
source=("joltphysics-${_ver_release}.tar.gz"
        "jolt_ndebug.diff"
)
sha256sums=('6e069ee0172478cc78182047aac87e5310ba14a67a53348ae14cc37801fd3f8e'
            '87ea69d0849c7c157fea3839a3883ed709440a5a5e77f428fecee9deb9eda0d5'
)

prepare() {
  cd "${_name_release}"

  # Voir blender
  patch -Np1 -i "${srcdir}/jolt_ndebug.diff"
}

build() {
  cd "${_name_release}/Build"

  cmake \
    -Bbuild \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS_RELEASE:STRING=-DNDEBUG \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_SKIP_RPATH=ON \
    -DCMAKE_DEBUG_POSTFIX=_d \
    -DDOUBLE_PRECISION=ON \
    -DCROSS_PLATFORM_DETERMINISTIC=ON \
    -DJPH_BUILD_SHARED_LIBS=ON \
    -DDEBUG_RENDERER_IN_DEBUG_AND_RELEASE=OFF \
    -DPROFILER_IN_DEBUG_AND_RELEASE=OFF \
    -DUSE_STATIC_MSVC_RUNTIME_LIBRARY=OFF \
    -DJPH_USE_DX12=OFF \
    -DJPH_USE_VK=ON \
    -DJPH_USE_MTL=OFF \
    -DTARGET_UNIT_TESTS=OFF \
    -DTARGET_HELLO_WORLD=OFF \
    -DTARGET_PERFORMANCE_TEST=OFF \
    -DTARGET_SAMPLES=OFF \
    -DTARGET_VIEWER=OFF \
    -DUSE_SSE4_1=ON \
    -DUSE_SSE4_2=ON \
    -DUSE_AVX=ON \
    -DUSE_AVX2=ON \
    -DUSE_AVX512=OFF \
    -DUSE_LZCNT=OFF \
    -DUSE_TZCNT=OFF \
    -DUSE_F16C=OFF \
    -DUSE_FMADD=OFF \

  make -C build
}

package() {
  cd "${_name_release}/Build"
  
  DESTDIR="${pkgdir}" make -C build install

  # license
  install -Dm644 ../LICENSE "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
