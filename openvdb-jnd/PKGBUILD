# Maintainer: Name <name@fai.com>

pkgname=openvdb-jnd
pkgver=14.0.0.20261029
pkgrel=1
_ver_release="14.0.0"
_name_release="openvdb-${_ver_release}"
pkgdesc='A large suite of tools for the efficient storage and manipulation of sparse volumetric data discretized on three-dimensional grids'
url='https://www.openvdb.org/'
arch=('x86_64')
license=('Apache-2.0')
depends=('glibc' 'libgcc' 'libstdc++'
         'onetbb' 'zlib' 'zstd'
         'jemalloc'
)
makedepends=('cmake' 'mesa'
)
conflicts=('openvdb' 'openvdb-git')
provides=('openvdb')
options=('!debug')
source=("OpenVDB-v${_ver_release}.tar.gz"
)
sha256sums=('2c38592a42a9dc1f3e9749418cc9d286d88ed912232dafee954ce5156174e5b0'
)

build() {
  cd "${_name_release}"

  cmake \
    -Bbuild \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS_RELEASE:STRING=-DNDEBUG \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_SKIP_RPATH=ON \
    -DOPENVDB_ENABLE_RPATH=OFF \
    -DUSE_NANOVDB=ON \
    -DOPENVDB_X86_INSTRSET=8 \
    -DUSE_CCACHE=OFF \
    -DOPENVDB_ENABLE_UNINSTALL=OFF \
    -DOPENVDB_CORE_STATIC=OFF
  
  make -C build
}

package() {
  cd "${_name_release}"

  DESTDIR="${pkgdir}" make -C build install
}
